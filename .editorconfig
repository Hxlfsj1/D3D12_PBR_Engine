# EditorConfig (https://editorconfig.org)
# Governs how EDITORS write files into the working tree (new files and saves).
# Complements .gitattributes, which governs Git checkouts. Scripts writing text
# must also preserve CRLF in the working tree; Git stores normalized LF.
root = true

[*]
end_of_line = crlf

# Binary or UTF-16 payloads (mirrors the -text list in .gitattributes):
# an editor must never "fix" their line endings
[*.{reg,lib,dll,pdb,exe,glb,hdr,pdf,ttf,otf}]
end_of_line = unset
