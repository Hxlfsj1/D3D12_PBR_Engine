{
  "rendering": {
    "use_deferred": true,
    "use_z_prepass": false
  },
  "DLSS SR": {
    "anti_aliasing": "DLSS",
    "dlss_quality": "Quality"
  },
  "shadows": {
    "cascades": {
      "transition_fraction": 0.1
    }
  },
  "ssgi": {
    "enabled": true,
    "sampling_mode": "screen_probes",
    "screen_trace_distance": 2.0,
    "screen_probes": {
      "rays_per_probe": 128,
      "screen_rays_per_probe": 64,
      "emissive_samples_per_probe": 48,
      "history_updates": 4,
      "jitter_width_fraction": 0.5
    },
    "world_sampling": {
      "mesh_min_hit_distance": 0.0,
      "mesh_max_trace_distance": 2.0,
      "max_trace_distance": 4.0
    },
    "trace_downsample_factor": 12,
    "intensity": 1
  },
  "vxgi": {
    "enabled": true,
    "voxel_size": 0.5,
    "debug_view": 0,
    "global_sdf": {
      "enabled": true,
      "cells_per_axis": [4, 8, 8],
      "clipmaps": 3,
      "cell_size": 0.25,
      "trace_distance": 128.0,
      "max_trace_steps": 256
    },
    "probes": {
      "padding_layers": 1,
      "probes_per_frame": 256,
      "classify_rays": 64,
      "rays_per_update": 64,
      "max_history_updates": 32,
      "backface_threshold": 0.25,
      "filter_neighbor_weight": 0.25
    },
    "sdf": {
      "cell_size": 0.1,
      "slice_axis": 2,
      "slice_position": 0.0
    },
    "surface": {
      "material_mip_level": 0.0,
      "ray_min_distance": 0.0001,
      "max_ray_distance": 128.0
    }
  },
  "hbao": {
    "enabled": true,
    "intensity": 2.0,
    "quality": 1,
    "radius": 0.5
  }
}
