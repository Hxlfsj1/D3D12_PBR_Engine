{
  "rendering": {
    "use_deferred": true,
    "use_z_prepass": false
  },
  "DLSS SR": {
    "anti_aliasing": "DLSS",
    "dlss_quality": "Quality"
  },
  "shadows": {
    "cascades": {
      "transition_fraction": 0.1
    }
  },
  "surface_cache": {
    "card_cell_size": 0.1,
    "max_cards_per_mesh": 12,
    "world_texel_size": 0.1,
    "max_distance": 32,
    "min_card_resolution": 16,
    "max_card_resolution": 512,
    "atlas_size": 2048
  },
  "world_geometry": {
    "enabled": true,
    "mesh_cell_size": 1,
    "mesh_trace_distance": 2,
    "trace_distance": 128,
    "global_sdf": {
      "enabled": true,
      "cells": 64,
      "clipmaps": 3,
      "cell_size": 0.5
    }
  },
  "ssgi": {
    "mode": "SSGI",
    "enabled": true,
    "sampling_mode": "screen_probes",
    "screen_trace_distance": 2,
    "max_trace_iterations": 96,
    "camera_fade": {
      "enabled": true,
      "start": 16,
      "end": 24
    },
    "screen_probes": {
      "screen_rays_per_probe": 64,
      "emissive_samples_per_probe": 48,
      "history_updates": 4,
      "jitter_width_fraction": 0.5,
      "adaptive": {
        "enabled": true,
        "max_fraction": 0.4
      }
    },
    "trace_downsample_factor": 24,
    "denoise_downsample_factor": 2,
    "intensity": 1
  },
  "hbao": {
    "enabled": true,
    "intensity": 2.0,
    "quality": 1,
    "radius": 0.5
  }
}
