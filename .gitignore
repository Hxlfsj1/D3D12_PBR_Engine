# Maintained Git directories (not ignored): Core/, Graphics/, Logic/, Resources/,
# Passes/, RDG/, Editor/, Shaders/, Settings/, ThirdParty/ and root project/docs.
# Keep Surface Cache, screen-probe and SDF source files in these directories.
# Local GI atlases, validation fixtures and review reports belong in tmp/ or
# Captures/ below; they are not runtime dependencies for a fresh clone.

# Visual Studio user data and caches
/.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build outputs and intermediate files
/x64/
/x86/
/arm64/
/Debug/
/Release/
/LearnDirectX/Debug/
/LearnDirectX/Release/
/LearnDirectX/x64/
/LearnDirectX/x86/
/LearnDirectX/arm64/
**/obj/
**/bin/
*.obj
*.iobj
*.ipdb
*.ilk
*.pdb
*.idb
*.tlog
*.lastbuildstate
*.recipe
*.Build.CppClean.log
*.VC.db
*.VC.opendb
*.opendb
*.sdf
*.ipch
*.cso
*.dxil
*.dxbc

# Restorable NuGet packages (keep packages.config tracked)
/packages/

# Local runtime art assets
/Models/
/HDRs/
/Scene_Assets/

# Local validation only: Surface Cache sharing/final-review reports, GPU captures,
# raw atlases, generated fixtures, build logs and temporary validation projects.
# Temporary files
/tmp/
/Captures/
/Logs/
/PassViewRun.json
*.tmp
*.temp
*.log

# Local tests and experiment reports (removed from the maintained repository)
/Tests/
/Docs/
/SSGI.md
/VXGI.md
/VXGI_PLAN.md

# Python helper caches
__pycache__/
*.pyc
*.pyo

# WorkBuddy agent workspace data (memory, logs) — never commit
/.workbuddy/

# Per-user ImGui window state
/imgui.ini
